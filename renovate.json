{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "kubernetes": {
    "fileMatch": [
      "\\.yaml$"
    ]
  },
  "packageRules": [
    {
      "description": "Update digests for all zgrzyt-ai images",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/^ghcr\\.io\\/mikolajbielinski\\/zgrzyt-/"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "automerge": false
    },
    {
      "description": "Flux manifests are regenerated as a whole by the flux manager; don't bump single controller images",
      "matchManagers": [
        "kubernetes"
      ],
      "matchFileNames": [
        "clusters/**/flux-system/gotk-components.yaml"
      ],
      "enabled": false
    }
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "dependencyDashboard": true
}
